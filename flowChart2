@startuml
start

partition "Initialization Phase" {
    :Initialize system variables;
    :Set Global Structure pointer to NULL;
}

:Display Menu 1:\n1. Queue\n2. Stack;

if (User Selection) then (Option 1 or 2\n[Queue / Stack])
    :Save Chosen Structure Type\n(Queue or Stack);
    
    partition "Data Structure Instantiation (Polymorphic)" {
        :Allocate Memory & Instantiate Structure\nwith an Array of 'Item' Pointers;
        note right
          The structure only knows about the Base Class ('Item').
          Example: structure = new Queue(MAX_SIZE); 
          (Inside: Item* array[MAX_SIZE])
        end note
    }
    
    :Display Menu 2:\n1. Identity\n2. Location;
    if (User Selection) then (Option 1 or 2\n[Identity / Location])
        :Save Chosen Item Type Attribute\n(Identity or Location);
        
        repeat
            :Display Menu 3:\n1. Add\n2. Remove\n3. Find Item\n4. List All Items\n5. Send Item\n6. Exit;
            switch (User Selection)
                case ( Choice = 1 )
                    partition "Polymorphic Allocation" {
                        :Instantiate specific Derived Object\nbased on saved Item Type choice;
                        note right
                          If Choice was Identity: Item* ptr = new Identity();
                          If Choice was Location: Item* ptr = new Location();
                        end note
                        :Push/Enqueue 'Item*' into Structure;
                    }
                case ( Choice = 2 )
                    :Execute REMOVE logic\n(Pops/Dequeues 'Item*' & deletes its allocated memory);
                case ( Choice = 3 )
                    :Execute FIND logic;
                case ( Choice = 4 )
                    :Execute LIST logic\n(Calls virtual print/display methods);
                case ( Choice = 5 )
                    :Execute SEND logic;
                case ( Choice = 6 )
                    :Delete all elements in the Array\n(Loop through and delete allocated Items);
                    :Delete Structure itself and free memory;
                    break
                case ( Default / Invalid )
                    :Show Error;
            endswitch
        repeat while (Choice == 6?) is (No) not (Yes)
    else (Invalid)
        :Show Error Message;
    endif

else (Invalid)
    :Show Error Message;
endif

stop
@enduml